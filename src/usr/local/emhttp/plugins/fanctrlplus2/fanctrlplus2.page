  function updatePWMLabelMap() {
    $.getJSON('/plugins/fanctrlplus2/include/FanctrlLogic.php?op=getpwm', function(pwmList) {
      pwmLabelMap = {};
      pwmList.forEach(pwm => {
        pwmLabelMap[pwm.sensor] = pwm.label || '';
