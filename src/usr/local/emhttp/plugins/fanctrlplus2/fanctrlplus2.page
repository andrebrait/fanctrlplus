  function bindPWMLabelInput(selectId, pwmList) {
    const inputId = pwmLabelInputIds[selectId];
    if (!inputId) return;

    const select = $('#' + selectId);
    const input = $('#' + inputId);
    const updateLabel = () => select.triggerHandler('change.fcpLabel');

