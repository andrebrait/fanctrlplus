  $(document).on('click', '.remove-disk-group-btn', function () {
    const $row = $(this).closest('.disk-group-row');
    const fanIndex = $row.data('fan-index');
    const $container = $('#disk-groups-' + fanIndex);

    if ($container.find('.disk-group-row').length <= 1) {
      alert('Each fan needs at least one disk group. Clear its disk selection instead if you want no disk monitoring.');
      return;
    }

    const groupName = $row.find('.disk-group-name-input').val().trim();
    const msg = groupName
      ? `Are you sure you want to delete disk group "${groupName}"?`
