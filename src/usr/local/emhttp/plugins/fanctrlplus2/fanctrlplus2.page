$cfg_dir = "/boot/config/plugins/$plugin";

// Load the shared fan-block renderer.
require_once "$docroot/plugins/$plugin/include/FanBlockRender.php";

// Initialize the configuration directory.
if (!is_dir($cfg_dir)) {
  mkdir($cfg_dir, 0777, true);
}

// Read every fanctrlplus2_*.cfg file.
$cfg_files = glob("$cfg_dir/{$plugin}_*.cfg");

if (empty($cfg_files)) {
  $temp_file = "$cfg_dir/{$plugin}_temp_0.cfg";
  if (!file_exists($temp_file)) {
file_put_contents($temp_file, <<<INI
custom=""
service="1"
controller=""
pwm="102"
max="255"
low="40"
high="60"
interval_sec="120"
disks=""
syslog="1"
cpu_enable="0"
cpu_sensor=""
cpu_min_temp=""
cpu_max_temp=""
INI
);
  }
  // Reload the configuration-file list.
  $cfg_files = glob("$cfg_dir/{$plugin}_*.cfg");
}  

// Read the left and right column order from order.cfg.
$order_left = [];
$order_right = [];

$order_file = "$cfg_dir/order.cfg";
if (is_file($order_file)) {
  $ini = parse_ini_file($order_file);
  foreach ($ini as $k => $v) {
    if (strpos($k, 'left') === 0)  $order_left[] = $v;
    if (strpos($k, 'right') === 0) $order_right[] = $v;
  }
}

// Track configurations already present in order.cfg.
$seen = array_flip(array_merge($order_left, $order_right));

// Prepare fan blocks for the left, right, and fallback groups.
$fan_column_left  = [];
$fan_column_right = [];
$all_cfg = [];

// Render the left column.
foreach ($order_left as $file) {
  $path = "$cfg_dir/$file";
  if (is_file($path)) {
    $cfg = parse_ini_file($path);
    $cfg['file'] = $file;
    $fan_column_left[] = $cfg;
    $all_cfg[] = $cfg;
  }
}

// Render the right column.
foreach ($order_right as $file) {
  $path = "$cfg_dir/$file";
  if (is_file($path)) {
    $cfg = parse_ini_file($path);
    $cfg['file'] = $file;
    $fan_column_right[] = $cfg;
    $all_cfg[] = $cfg;
  }
}

// Put saved configurations missing from order.cfg in the right column.
foreach ($cfg_files as $path) {
  $basename = basename($path);
  if (!isset($seen[$basename]) && strpos($basename, '_temp_') === false) {
    $cfg = parse_ini_file($path);
    $cfg['file'] = $basename;
    $fan_column_right[] = $cfg;
    $all_cfg[] = $cfg;
  }
}

// Put every temp_x.cfg in the right column by default.
foreach ($cfg_files as $path) {
  $basename = basename($path);
  if (strpos($basename, '_temp_') !== false) {
    $cfg = parse_ini_file($path);
    $cfg['file'] = $basename;
    $fan_column_right[] = $cfg;
    $all_cfg[] = $cfg;
  }
}
$pwms = list_pwm();
$disks = list_valid_disks_by_id();
$width = 300;
$cpu_sensors = detect_cpu_sensors();
$aux_sensors = detect_aux_sensors();

// Read a dashboard-tile switch (e.g. __FCP_AIRFLOW__, __FCP_HISTORY__).
function fcp_labels_flag_enabled(string $cfg_dir, string $flag): bool {
  $labels_file = $cfg_dir.'/pwm_labels.cfg';
  if (!is_file($labels_file)) return false;
  foreach (file($labels_file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) as $ln) {
    $ln = trim($ln);
    if ($ln === '' || $ln[0] === '#') continue;
    if (preg_match('/^'.preg_quote($flag, '/').'\s*=\s*([01])\s*$/', $ln, $m)) {
      return $m[1] === '1';
    }
  }
  return false;
}

$fcp_airflow_enabled = fcp_labels_flag_enabled($cfg_dir, '__FCP_AIRFLOW__');
$fcp_history_enabled = fcp_labels_flag_enabled($cfg_dir, '__FCP_HISTORY__');
