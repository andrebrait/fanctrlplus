Menu="Dashboard:0"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.11.9','>')"
---
<?php
$pluginname = "fanctrlplus2";
$docroot = $docroot ?? ($_SERVER['DOCUMENT_ROOT'] ?? '/usr/local/emhttp');
if ($docroot === '') $docroot = '/usr/local/emhttp';
require_once "$docroot/plugins/$pluginname/include/Common.php";
$fontStyleUrl = htmlspecialchars(fcp_asset_url('fonts/style.css'), ENT_QUOTES, 'UTF-8');
$cfg_path = "/boot/config/plugins/$pluginname";
$cfg_files = glob("$cfg_path/{$pluginname}_*.cfg");

$order_file = "$cfg_path/order.cfg";
$order = [];
$all_cfg = [];

// Read the service state.
$status_text = file_exists("/var/run/{$pluginname}.pid") ? "Running" : "Inactive";
$status_color = $status_text === "Running" ? "green-text" : "red-text";

// Read the saved order first.
if (file_exists($order_file)) {
  $ini = parse_ini_file($order_file);
  $order = array_values($ini);
}

// Add existing configurations in saved order.
foreach ($order as $file) {
  $path = "$cfg_path/$file";
  if (is_file($path)) {
    $cfg = parse_ini_file($path);
    $cfg['file'] = $file;
    $all_cfg[] = $cfg;
  }
}

// Append configurations missing from the saved order, including temporary ones.
$seen = array_flip($order);
foreach ($cfg_files as $path) {
  $basename = basename($path);
  if (!isset($seen[$basename])) {
    $cfg = parse_ini_file($path);
    $cfg['file'] = $basename;
    $all_cfg[] = $cfg;
  }
}

// Build the HTML rows.
$fan_rows = "";
foreach ($all_cfg as $cfg) {
  // Skip unnamed fans.
  if (empty($cfg['custom'])) continue;
  $label = htmlspecialchars($cfg['custom'], ENT_QUOTES, 'UTF-8');

  $fan_rows .= <<<ROW
  <tr class="fcp-row" data-label="$label">
    <td><div class="fcp-line">
      <span class="fcp-cell fcp-name" title="$label">$label</span>
      <span class="fcp-cell fcp-num fp-temp">--</span>
      <span class="fcp-cell fcp-src fp-origin"></span>
      <span class="fcp-cell fcp-num fp-rpm">--</span>
      <span class="fcp-cell fcp-num fp-pct">--</span>
      <span class="fcp-cell fcp-status fp-status">--</span>
      <span class="fcp-cell fcp-run">
        <span class="fa fa-refresh fanctrlplus2-refresh"
          data-label="$label"
          style="cursor:pointer;font-size:13px;color:var(--blue-800);vertical-align:middle;"
          title="Manual Run: Read current temperature and set fan speed immediately"></span>
      </span>
    </div></td>
  </tr>
  ROW;
}

// Tile styles.
echo '<link rel="stylesheet" href="' . $fontStyleUrl . '">' . PHP_EOL;
echo <<<STYLE
<style>
/* Top status. */
.fanctrlplus2-status{
  font-weight: normal;
  font-size: 12px;
  display: inline-block;
  margin-bottom: 6px;
}

/* One value per column; units live in the headers. Cells clip with an
   ellipsis, like Unraid's w18/w26 but without their hover overflow, which
   would draw a long value over the next column. */
#fanctrlplus2-dashboard .fcp-line{ display:flex; align-items:baseline; }
#fanctrlplus2-dashboard .fcp-cell{
  flex:none;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  box-sizing:border-box;
}
#fanctrlplus2-dashboard .fcp-name  { width:19%; padding-right:8px; }
#fanctrlplus2-dashboard .fcp-num   { text-align:right; padding-right:12px; font-variant-numeric:tabular-nums; }
#fanctrlplus2-dashboard .fp-temp   { width:13%; }
#fanctrlplus2-dashboard .fcp-src   { width:22%; padding-right:8px; }
#fanctrlplus2-dashboard .fp-rpm    { width:16%; }
#fanctrlplus2-dashboard .fp-pct    { width:12%; }
#fanctrlplus2-dashboard .fcp-status{ width:12%; }
#fanctrlplus2-dashboard .fcp-run   { width:6%; text-align:center; }
#fanctrlplus2-dashboard tr.fcp-row .fcp-src{ opacity:.65; }

/* Narrow screens: abbreviated headings, and each fan's source on a second
   line instead of its own column. */
#fanctrlplus2-dashboard .fcp-head .mobile{ display:none; }
@media (max-width:1080px){
  #fanctrlplus2-dashboard .fcp-head .full  { display:none; }
  #fanctrlplus2-dashboard .fcp-head .mobile{ display:inline; }
  #fanctrlplus2-dashboard .fcp-line{ flex-wrap:wrap; }
  #fanctrlplus2-dashboard tr.header .fcp-src{ display:none; }
  #fanctrlplus2-dashboard tr.fcp-row .fcp-src{ order:1; width:100%; font-size:90%; }
  #fanctrlplus2-dashboard .fcp-num   { padding-right:6px; }
  #fanctrlplus2-dashboard .fcp-name  { width:26%; }
  #fanctrlplus2-dashboard .fp-temp   { width:13%; }
  #fanctrlplus2-dashboard .fp-rpm    { width:18%; }
  #fanctrlplus2-dashboard .fp-pct    { width:13%; }
  #fanctrlplus2-dashboard .fcp-status{ width:21%; }
  #fanctrlplus2-dashboard .fcp-run   { width:9%; }
}
</style>
STYLE;

// Render the tile.
$isResponsiveWebgui = version_compare((parse_ini_file('/etc/unraid-version')['version'] ?? '0.0.0'), '7.2.0-beta', '>=');
$tbodyClass = $isResponsiveWebgui ? 'mixed' : 'sortable';

$headerSection = $isResponsiveWebgui
  ? "<h3 class='tile-header-main'>FanCtrl Plus 2</h3>\n<span class='fanctrlplus2-status $status_color'>Status: $status_text</span>"
  : "FanCtrl Plus 2<br>\n<span class='fanctrlplus2-status $status_color'>Status: $status_text</span><br>";

$mytiles[$pluginname]['column2'] = <<<EOT
<tbody id="fanctrlplus2-dashboard" class="$tbodyClass" title="FanCtrl Plus 2">
  <tr>
    <td>
      <span class="tile-header">
        <span class="tile-header-left">
          <i class="icon-fanctrlplus2 f32"></i>
          <div class="section">
            $headerSection
          </div>
        </span>
        <span class="tile-header-right">
          <span class="tile-header-right-controls">
            <a href="/Settings/fanctrlplus2" title="Go to FanCtrl Plus 2 settings">
              <i class="fa fa-fw fa-cog control"></i>
            </a>
        </span>
      </span>
    </td>
  </tr>

  <tr class="header">
    <td><div class="fcp-line">
      <span class="fcp-cell fcp-name">NAME</span>
      <span class="fcp-cell fcp-num fp-temp fcp-head"><span class="full">TEMP (°C)</span><span class="mobile">°C</span></span>
      <span class="fcp-cell fcp-src">SOURCE</span>
      <span class="fcp-cell fcp-num fp-rpm fcp-head"><span class="full">SPEED (RPM)</span><span class="mobile">RPM</span></span>
      <span class="fcp-cell fcp-num fp-pct fcp-head"><span class="full">PWM (%)</span><span class="mobile">%</span></span>
      <span class="fcp-cell fcp-status">STATUS</span>
      <span class="fcp-cell fcp-run">RUN</span>
    </div></td>
  </tr>

  $fan_rows
</tbody>
EOT;
?>
<script>
// Fill one fan's row. The server sends the source without parentheses ("CPU",
// "Disk: Group", "Idle") and "*" as the temperature while idling.
function setFanRow(tile, f) {
  const key = (window.CSS && CSS.escape) ? CSS.escape(f.label) : String(f.label).replace(/"/g, '\\"');
  const row = tile.querySelector(`tr.fcp-row[data-label="${key}"]`);
  if (!row) return;

  const temp = (f.temp_raw == null || f.temp_raw === '-' || f.temp_raw === '*') ? '--' : f.temp_raw;
  const origin = (f.temp_origin ?? '').toString().trim() || '--';
  const cells = {
    '.fp-temp':   temp,
    '.fp-origin': origin,
    '.fp-rpm':    (f.rpm_val == null || f.rpm_val === '-') ? '--' : f.rpm_val,
    '.fp-pct':    (f.percent == null || f.percent === '-') ? '--' : f.percent,
  };
  for (const [sel, text] of Object.entries(cells)) {
    const el = row.querySelector(sel);
    if (el) el.textContent = text;
  }
  const src = row.querySelector('.fp-origin');
  if (src) src.title = origin;
  const stat = row.querySelector('.fp-status');
  if (stat) stat.innerHTML = (f.status ?? '--');
}

function updateFanctrlplusTile() {
  const tile = document.getElementById("fanctrlplus2-dashboard");
  if (!tile) return;

  fetch("/plugins/fanctrlplus2/Fanctrl2Dashboard.php", {cache: 'no-store'})
    .then(res => res.json())
    .then(data => {
      // Top status.
      const statusSpan = tile.querySelector(".fanctrlplus2-status");
      if (statusSpan) {
        statusSpan.textContent = `Status: ${data.status}`;
        statusSpan.className = "fanctrlplus2-status " + (data.status === "Running" ? "green-text" : "red-text");
      }

      (data.fans || []).forEach(f => setFanRow(tile, f));
    })
    .catch(() => {
      const statusSpan = tile?.querySelector(".fanctrlplus2-status");
      if (statusSpan) statusSpan.textContent = "Status: Loading...";

      // Reset every value cell.
      tile?.querySelectorAll('tr.fcp-row').forEach(row => {
        row.querySelectorAll('.fp-temp, .fp-origin, .fp-rpm, .fp-pct, .fp-status').forEach(n => n.textContent = '--');
      });
    });
}

// Run a single fan immediately.
function refreshSingleFan(custom) {
  fetch(`/plugins/fanctrlplus2/include/FanctrlLogic.php?op=refresh_single&custom=${encodeURIComponent(custom)}`, {cache: 'no-store'})
    .then(() => setTimeout(updateFanctrlplusTile, 2000)); // Refresh after two seconds.
}

document.addEventListener("DOMContentLoaded", function () {
  setTimeout(updateFanctrlplusTile, 200);
  setInterval(updateFanctrlplusTile, 5000);

  const dashboard = document.getElementById("fanctrlplus2-dashboard");
  if (dashboard) {
    dashboard.addEventListener("click", function(e) {
      const btn = e.target.closest('.fanctrlplus2-refresh');
      if (!btn) return;

      const label = btn.getAttribute('data-label');
      btn.style.color = '#aaa';
      btn.classList.add('fa-spin');

      refreshSingleFan(label);

      setTimeout(() => {
        btn.style.color = 'var(--blue-800)';
        btn.classList.remove('fa-spin');
      }, 1800);

      e.preventDefault();
      e.stopPropagation();
    });
  }
});
</script>
