plugin="fanctrlplus2"
cfg_path="/boot/config/plugins/$plugin"
loop_script="/usr/local/emhttp/plugins/$plugin/scripts/fanctrlplus2_loop.sh"
dashboard_updater="/usr/local/emhttp/plugins/$plugin/scripts/fanctrlplus2_dashboard_update.sh"
pid_dir="/var/run"

fanctrlplus2.start() {
  # Clear the user-requested stop marker.
  rm -f /var/run/fanctrlplus2.user_stopped

  pkill -f "$loop_script" 2>/dev/null

  # Migrate configuration and labels before starting.
  php -r "require_once '/usr/local/emhttp/plugins/fanctrlplus2/include/Common.php'; migrate_cfg_and_labels('fanctrlplus2');"

  for cfg in "$cfg_path"/${plugin}_*.cfg; do
    [[ -f "$cfg" ]] || continue

    service=$(grep -Po '^service="\K[^"]+' "$cfg")
    [[ "$service" != "1" ]] && continue

    # Sanitize the custom name before using it in a PID filename.
    raw_custom=$(grep -Po '^custom="\K[^"]+' "$cfg")
    clean_custom=$(echo "$raw_custom" | tr -d '\r\n\t ')
    custom_safe=$(echo "$clean_custom" | tr -cd '[:alnum:]_-')

    [[ -z "$custom_safe" ]] && continue

    nohup "$loop_script" "$cfg" > /dev/null 2>&1 &
    echo $! > "$pid_dir/${plugin}_${custom_safe}.pid"
    logger -t "$plugin" "Started [$custom_safe] from $cfg"
  done

  # Start array_monitor.sh if it is not already running.
  script="/usr/local/emhttp/plugins/fanctrlplus2/scripts/array_monitor.sh"
  if [ -x "$script" ] && ! pgrep -f "$script" >/dev/null; then
    nohup "$script" >/dev/null 2>&1 &
  fi

  # Restart the dashboard updater without creating duplicates.
  pkill -f "$dashboard_updater" 2>/dev/null
  if [[ -x "$dashboard_updater" ]]; then
    nohup "$dashboard_updater" >/dev/null 2>&1 &
  fi
}

fanctrlplus2.stop() {
  # Record that the user requested a stop.
  touch /var/run/fanctrlplus2.user_stopped

  pkill -f "$loop_script"
  rm -f "$pid_dir"/${plugin}_*.pid
  logger -t "$plugin" "All fanctrlplus2 stopped"

  # Stop the dashboard updater.
  pkill -f "$dashboard_updater"

  # Set only fanctrlplus2-controlled PWM outputs to 50%.
  for cfg in "$cfg_path"/${plugin}_*.cfg; do
    [[ -f "$cfg" ]] || continue

    service=$(grep -Po '^service="\K[^"]+' "$cfg")
    [[ "$service" != "1" ]] && continue

    pwm=$(grep -Po '^controller="\K[^"]+' "$cfg")
    [[ -z "$pwm" || ! -w "$pwm" ]] && continue

    enable="${pwm}_enable"
    if [[ -w "$enable" ]]; then
      echo 1 > "$enable"
      echo 128 > "$pwm"
      logger -t "$plugin" "Stopped control of $(basename "$pwm"); set to 50% (manual mode) to ensure sufficient airflow and avoid overheating"
    fi
  done
}

fanctrlplus2.status() {
  for pidfile in "$pid_dir"/${plugin}_*.pid; do
    [[ -f "$pidfile" ]] || continue
    pid=$(cat "$pidfile")
    if kill -0 "$pid" 2>/dev/null; then
      echo "running"
      return
    fi
  done
  echo "stopped"
}

case "$1" in
  start) fanctrlplus2.start ;;
  stop) fanctrlplus2.stop ;;
  restart)
    fanctrlplus2.stop
    sleep 1
    fanctrlplus2.start
    ;;
  status) fanctrlplus2.status ;;
  *) echo "Usage: $0 {start|stop|restart|status}" ;;
esac
